<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AppConfig.Application.TEP_TimeshareExhangPlatform"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_tep_app"
        android:label="Unwind"
        android:roundIcon="@drawable/logo_tep_app"
        android:supportsRtl="true"
        android:theme="@style/Base.Theme.TEPTimeshareExchangePlatform"
        tools:targetApi="31">
        <activity
