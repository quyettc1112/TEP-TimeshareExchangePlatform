        <activity
            android:name=".UI.Activity.ResortDetailActivity.ImageListActivity"
            android:exported="true" />
        <activity
            android:name=".UI.Activity.ResortDetailActivity.ResortDetailActivity"
            android:exported="true" />
        <activity
            android:name=".UI.Activity.LoginActivity.LoginActivity_screen2"
            android:exported="true" />
