<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TEPTimeshareExchangePlatform" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true
        </item> <!-- Điều này sẽ làm cho các biểu tượng và văn bản màu đen -->
    </style>

    <style name="MyBottomSheetDialogTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <!-- Customize colors, shapes, etc. here -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.SmallComponent
        </item>
        <item name="bottomSheetStyle">@style/Widget.Material3.BottomSheet.Modal</item>
    </style>


    <style name="Theme.TEPTimeshareExchangePlatform.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.TEPTimeshareExchangePlatform.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


    <!-- res/values/styles.xml -->
    <style name="Theme.MyMaterialDialog" parent="Theme.Material3.DayNight.Dialog">
        <!-- Customize your dialog theme here -->
        <item name="windowNoTitle">true</item>
        <item name="windowMinWidthMajor">90%</item>
        <item name="windowMinWidthMinor">90%</item>
    </style>

    <style name="Base.Theme.TEPTimeshareExchangePlatform.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Base.Theme.TEPTimeshareExchangePlatform.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Base.Theme.TEPTimeshareExchangePlatform.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="CustomDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>


</resources>