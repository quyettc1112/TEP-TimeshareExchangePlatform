<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient Border -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FF6A00"
                android:endColor="#D84B16"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Inner Solid Background -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape>
            <solid android:color="#ffffff" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
