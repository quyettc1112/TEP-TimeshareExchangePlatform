<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background_F9"
    tools:context=".UI.Activity.CommonActivity.BookingDetailActivity.BookingDetailActivity">

    <com.example.tep_timeshareexchangeplatform.AppConfig.CustomView.CustomToolbar.CustomToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:title="Đặt Phòng Của Tôi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showStartText="false" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="52dp"
        android:background="@color/white"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!--// Room Code-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <!--// Resort Status-->
                    <LinearLayout
                        android:id="@+id/ll_status_container"
                        android:layout_gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/ripple_effect"
                        android:backgroundTint="@color/white"
                        android:elevation="3dp"
                        android:padding="5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_status"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:saveEnabled="false"
                            app:cardCornerRadius="30dp"
                            app:strokeColor="@color/red_light"
                            app:strokeWidth="5dp" />


                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:fontFamily="@font/inter_extrabold"
                            android:text="Đã xác nhận"
                            android:textColor="@color/red_light"
                            android:textSize="10dp" />
                    </LinearLayout>

                    <!--// Room Reservation Code-->
                    <TextView
                        android:id="@+id/tv_room_reservation_code"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:text="Mã đặt phòng: "
                        android:textSize="16dp" />

                    <!--// Bar Code-->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="5dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_code_room" />

                    <!--// Note-->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/inter_light"
                        android:text="Ghi chú: Vui lòng đưa barcode hoặc mã đặt phòng cho nhân viên để được check in."
                        android:textSize="12dp" />

                    <!--// Type Booking-->
                    <LinearLayout
                        android:id="@+id/ll_type_booking_container"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:backgroundTint="@color/white"
                        android:elevation="3dp"
                        android:gravity="center"
                        android:padding="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_rental_booking" />


                        <TextView
                            android:id="@+id/tv_booking_tupe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="Thuê Phòng"
                            android:textColor="@color/black"
                            android:textSize="12dp" />
                    </LinearLayout>

                    <!--// Check in Day, Check Out day-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <LinearLayout
                            android:background="@drawable/ripple_effect_white"
                            android:layout_margin="5dp"
                            android:backgroundTint="@color/blue_header_section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4.5">

                            <!-- Check-in Date Section -->
                            <LinearLayout
                                android:layout_margin="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <!-- Label for Check-in Date -->
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:maxLines="1"
                                        android:fontFamily="@font/inter_medium"
                                        android:text="Ngày Nhận Phòng"
                                        android:textColor="@color/gray_text"
                                        android:textSize="12sp" />
                                    <ImageView
                                        android:src="@drawable/ic_check_in"
                                        android:layout_width="20dp"
                                        android:layout_height="match_parent"/>


                                </LinearLayout>


                                <!-- Check-in Date -->
                                <TextView
                                    android:id="@+id/tv_checkin_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:fontFamily="@font/inter_bold"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <!-- Check-in Day -->
                                <TextView
                                    android:id="@+id/tv_checkin_dayOfWeek"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/inter_bold"
                                    android:text=""
                                    android:textColor="@color/gray_text"
                                    android:textSize="14sp" />
                            </LinearLayout>




                        </LinearLayout>


                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/ic_arrow_right" />

                        <LinearLayout
                            android:background="@drawable/ripple_effect_white"
                            android:layout_margin="5dp"
                            android:backgroundTint="@color/blue_header_section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="4.5">

                            <!-- Check-in Date Section -->
                            <LinearLayout
                                android:layout_margin="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <!-- Label for Check-in Date -->
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:maxLines="1"
                                        android:fontFamily="@font/inter_medium"
                                        android:text="Ngày Trả Phòng"
                                        android:textColor="@color/gray_text"
                                        android:textSize="12sp" />
                                    <ImageView
                                        android:src="@drawable/ic_check_out"
                                        android:layout_width="20dp"
                                        android:layout_height="match_parent"/>


                                </LinearLayout>


                                <!-- Check-in Date -->
                                <TextView
                                    android:id="@+id/tv_checkout_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:fontFamily="@font/inter_bold"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <!-- Check-in Day -->

                                <TextView
                                    android:id="@+id/tv_checkout_dayOfWeek"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/inter_bold"
                                    android:text=""
                                    android:textColor="@color/gray_text"
                                    android:textSize="14sp" />
                            </LinearLayout>




                        </LinearLayout>


                    </LinearLayout>

                    <!--// Feedback-->
                    <LinearLayout
                        android:id="@+id/ll_feedback_container"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:background="@drawable/background_stroke_around"
                        android:weightSum="3"
                        android:orientation="horizontal"
                        android:gravity="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout27" >
                        <TextView
                            android:gravity="center|right"
                            android:layout_weight="2"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:text="Gửi Đánh Giá"
                            android:textSize="12dp"
                            android:fontFamily="@font/inter_semibold"
                            android:textStyle="italic"
                            android:textColor="@color/blue_see_more"/>
                        <ImageView
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_star"/>
                    </LinearLayout>



                </LinearLayout>

                <!--// Guest Info-->
                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_stroke_around"
                    android:padding="16dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tv_guest_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông tin khách nhận phòng"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter_bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khách nhận phòng"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Full Name Field -->
                    <EditText
                        android:id="@+id/et_full_name"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:enabled="false"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:padding="10dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_guest_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />


                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số Điện Thoại"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Phone Number Field -->
                    <EditText
                        android:id="@+id/et_phone_number"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:maxLines="1"
                        android:enabled="false"
                        android:textSize="14sp"
                        android:padding="10dp"
                        app:layout_constraintTop_toBottomOf="@id/et_full_name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />


                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Email Field -->
                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:maxLines="1"
                        android:enabled="false"
                        android:text="www.tranlenovo123@gmail.com"
                        android:textSize="14sp"
                        android:padding="10dp"
                        app:layout_constraintTop_toBottomOf="@id/et_phone_number"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />


                </LinearLayout>

                <!--// Detail Billing-->
                <include android:id="@+id/include_detail_billing"
                    layout="@layout/include_detail_billing"/>

            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>