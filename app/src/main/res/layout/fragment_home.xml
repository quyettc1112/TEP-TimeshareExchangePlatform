<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background"
    tools:context=".UI.Fragment.HomeFragment.HomeFragment">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:src="@drawable/logo_unwind_horizontal" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fillViewport="true"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="100dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                android:layout_margin="20dp">
                <LinearLayout
                    android:id="@+id/ll_location"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:background="@drawable/background_stroke_around"
                    android:weightSum="10"
                    android:layout_height="65dp"
                    android:layout_marginBottom="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layout_weight="1.75">
                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_location" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="left"
                        android:weightSum="10"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_weight="8.25">
                        <TextView
                            android:gravity="center|left"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5"
                            android:text="@string/search_location"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            android:textSize="16dp" />

                        <TextView
                            android:id="@+id/tv_location"
                            android:gravity="center|left"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5"
                            android:text="Thành Phố Hồ Chí Minh, Việt Nam"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/black"
                            android:textSize="14dp"/>

                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_date"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:background="@drawable/background_stroke_around"
                    android:weightSum="10"
                    android:layout_height="65dp"
                    android:layout_marginBottom="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layout_weight="1.75">
                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_schedule" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="left"
                        android:weightSum="10"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_weight="8.25">
                        <TextView
                            android:gravity="center|left"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5"
                            android:text="@string/search_date"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            android:textSize="16dp" />

                        <TextView
                            android:id="@+id/tv_date"
                            android:gravity="center|left"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5"
                            android:text="01/09/2024 - 02/09/2024"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/black"
                            android:textSize="14dp"/>

                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_tourist"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:background="@drawable/background_stroke_around"
                    android:weightSum="10"
                    android:layout_height="65dp"
                    android:layout_marginBottom="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layout_weight="1.75">
                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_person" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="left"
                        android:weightSum="10"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_weight="8.25">
                        <TextView
                            android:gravity="center|left"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5"
                            android:text="@string/search_tourie"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            android:textSize="16dp" />

                        <TextView
                            android:id="@+id/tv_tourist"
                            android:gravity="center|left"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="5"
                            android:text="5 khách, 2 phòng"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/black"
                            android:textSize="14dp"/>

                    </LinearLayout>

                </LinearLayout>
                <Button
                    android:id="@+id/btn_filter"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/background_btn_search"
                    android:text="Lọc"
                    android:textColor="@color/white"
                    android:textSize="16dp" />





            </LinearLayout>






        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>