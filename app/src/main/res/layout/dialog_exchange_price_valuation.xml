<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <!--// Exchange Price Valuation-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ll_exchange_method"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:cardCornerRadius="17dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--// Title Text-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_effect_white"
                android:backgroundTint="@color/blue_header_section"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_medium"
                    android:maxWidth="300dp"
                    android:padding="5dp"
                    android:text="Thay Đổi Giá Bù Tiền"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--// Exchange Price Valuation-->
            <LinearLayout
                android:id="@+id/ll_exchange_price_valuation"
                android:background="@drawable/ripple_effect_white"
                android:backgroundTint="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">


                <RadioGroup
                    android:id="@+id/radioGroupExchangeOptions"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioNoPaymentNeeded"
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:text="Không bù tiền" />

                    <TextView
                        android:id="@+id/tvNoPaymentNeededDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cả hai bên không cần thanh toán thêm khoản tiền nào để thực hiện trao đổi."
                        android:paddingStart="10dp"
                        android:textSize="12sp"
                        android:textColor="?attr/colorSecondary" />

                    <RadioButton
                        android:id="@+id/radioOwnerPaysDifference"
                        android:layout_marginTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:text="Tôi sẽ bù tiền chênh lệch nhưng thay đổi giá" />

                    <TextView
                        android:id="@+id/tvOwnerPaysDifferenceDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chủ sở hữu sẽ thanh toán số tiền chênh lệch để hoàn tất trao đổi."
                        android:paddingStart="10dp"
                        android:textSize="12sp"
                        android:textColor="?attr/colorSecondary" />

                    <RadioButton
                        android:id="@+id/radioPayDifferenceToOwner"
                        android:layout_marginTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tôi muốn người gửi yêu cầu trao đổi bù tiền chênh lệch cho tôi" />

                    <TextView
                        android:id="@+id/tvPayDifferenceToOwnerDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Người gửi yêu cầu sẽ thanh toán số tiền chênh lệch để hoàn tất trao đổi."
                        android:paddingStart="10dp"
                        android:textSize="12sp"
                        android:textColor="?attr/colorSecondary" />




                </RadioGroup>


                <!-- Layout chứa phần tiền tệ và trường nhập giá -->
                <LinearLayout
                    android:id="@+id/ll_price_input"
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center|left"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRoomPrice"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        app:helperTextTextColor="@android:color/holo_red_dark"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvRoomPriceSubtitle">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRoomPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:hint="Nhập Giá Bù Tiền"
                            android:textColor="@color/black"
                            android:fontFamily="@font/inter_extrabold"
                            android:maxLines="1"
                            android:inputType="numberDecimal"
                            android:padding="12dp"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/ll_payment_method_12"
                        android:layout_marginStart="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:weightSum="2"
                        app:layout_constraintTop_toBottomOf="@+id/tilRoomPrice">

                        <!-- Input for Room Price -->
                        <EditText
                            android:id="@+id/et_total_price"
                            android:layout_width="0dp"
                            android:layout_marginTop="15dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:background="@drawable/background_stroke_around"
                            android:backgroundTint="@color/primary_background_F9"
                            android:enabled="false"
                            android:hint="Giá tiền cho tổng số đêm"
                            android:inputType="numberDecimal"
                            android:padding="12dp" />

                    </LinearLayout>


                </LinearLayout>



            </LinearLayout>

            <!--// Description-->
            <LinearLayout
                android:background="@color/white"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Nights Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:fontFamily="@font/inter_bold"
                    android:text="Ghi Chú"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNote"
                    android:enabled="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/background_stroke_around"
                    android:gravity="top|start"
                    android:inputType="text|textShortMessage"
                    android:minHeight="100dp"
                    android:padding="10dp"
                    android:textSize="14dp" />

                <LinearLayout
                    android:id="@+id/btn_save"
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/ripple_effect_white"
                    android:backgroundTint="@color/primaryColor"
                    android:clickable="true"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Icon chọn ngày"
                        android:src="@drawable/baseline_currency_exchange_24" />

                    <!-- Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center_vertical"
                        android:text="Thay Đổi"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>