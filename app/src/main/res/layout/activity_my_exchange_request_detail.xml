<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".UI.Activity.UserActivity.MyRentalPostingActivity.PricingSupportActivity.PricingSupportActivity">


    <!--// Custom Toolbar-->
    <com.example.tep_timeshareexchangeplatform.AppConfig.CustomView.CustomToolbar.CustomToolbar
        android:id="@+id/customToolbar5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:title="Chi Tiết Yêu Cầu Trao Đổi"
        app:layout_constraintTop_toTopOf="parent"
        app:showStartText="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@+id/customToolbar5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/constraintLayout13"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/customToolbar5">

                <!--// Status-->
                <LinearLayout
                    android:id="@+id/ll_status_container"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_gravity="right"
                    android:layout_margin="5dp"
                    android:elevation="3dp"
                    android:background="@drawable/ripple_effect"
                    android:backgroundTint="@color/white"
                    android:padding="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_status"
                        android:visibility="gone"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:saveEnabled="false"
                        app:cardCornerRadius="100dp"
                        app:strokeColor="@color/red_light"
                        app:strokeWidth="8dp" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/red_light"
                        android:textSize="12dp" />
                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="1"
                    android:text="Người Gửi Yêu Cầu"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <!-- Owner Info Row -->
                <LinearLayout
                    android:id="@+id/ownerInfoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/iv_ownerAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/placeholder_image"
                        app:riv_corner_radius="50dp" />


                    <TextView
                        android:id="@+id/tv_ownerFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="1"
                        android:textSize="14sp" />


                </LinearLayout>

                <!--// Verify Button-->
                <LinearLayout
                    android:id="@+id/ll_verify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout9">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_gravity="left|center"
                        android:layout_weight="0.5"
                        android:src="@drawable/ic_verify" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center"
                        android:layout_weight="9"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="2"
                        android:paddingStart="5dp"
                        android:text="Đã xác thực và Đảm Bảo bởi Unwind"
                        android:textSize="14sp" />


                </LinearLayout>

                <!--// Room Info-->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/materialCardView6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center|left"
                            android:orientation="horizontal"
                            android:padding="5dp"
                            android:weightSum="2">

                            <!-- // Image-->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/materialCardView"
                                android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="5dp"
                                android:layout_weight="0.1"
                                app:cardCornerRadius="10dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:strokeColor="@color/yellow_stroke_image"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:id="@+id/im_imageTimeshare"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.9"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/materialCardView"
                                app:layout_constraintTop_toTopOf="parent">


                                <!--// Room Info-->
                                <LinearLayout
                                    android:id="@+id/linearLayout17"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginEnd="10dp"
                                    android:orientation="vertical"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/materialCardView"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <!--// Resort name-->
                                    <TextView
                                        android:id="@+id/tv_resortName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_semibold"
                                        android:maxLines="2"
                                        android:textColor="@color/black"
                                        android:textSize="14dp" />

                                    <TextView
                                        android:id="@+id/tv_room_code"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:fontFamily="@font/inter_regular"
                                        android:gravity="top"
                                        android:maxLines="2"
                                        android:textColor="@color/black"
                                        android:textSize="14dp" />


                                </LinearLayout>

                                <!-- Check-in Date -->
                                <LinearLayout
                                    android:id="@+id/linearLayout16"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:gravity="center|left"
                                    android:orientation="horizontal"
                                    android:paddingTop="4dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/materialCardView"
                                    app:layout_constraintTop_toBottomOf="@+id/linearLayout17">

                                    <ImageView
                                        android:layout_width="15dp"
                                        android:layout_height="15dp"
                                        android:src="@drawable/ic_check_in" />

                                    <TextView
                                        android:id="@+id/tv_check_in_date"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1.5"
                                        android:gravity="start"
                                        android:textColor="#000000"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Check-Out Date -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:gravity="center|left"
                                    android:orientation="horizontal"
                                    android:paddingTop="4dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/materialCardView"
                                    app:layout_constraintTop_toBottomOf="@+id/linearLayout16">

                                    <ImageView
                                        android:layout_width="15dp"
                                        android:layout_height="15dp"
                                        android:src="@drawable/ic_check_out" />

                                    <TextView
                                        android:id="@+id/tv_check_out_date"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:gravity="start"

                                        android:textColor="#000000"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Nights -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:gravity="center|left"
                                    android:orientation="horizontal"
                                    android:paddingTop="4dp"
                                    android:weightSum="2"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/materialCardView"
                                    app:layout_constraintTop_toBottomOf="@+id/linearLayout16">

                                    <ImageView
                                        android:layout_width="15dp"
                                        android:layout_height="15dp"
                                        android:padding="2dp"
                                        android:src="@drawable/ic_nights" />

                                    <TextView
                                        android:id="@+id/tv_nights"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:gravity="start"
                                        android:textColor="#000000"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                            </LinearLayout>


                        </LinearLayout>

                        <!--// Unit Type-->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp">

                            <include
                                android:id="@+id/include_unit_type"
                                layout="@layout/include_unit_type"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/materialCardView6">

                    <!-- Mức giá đề xuất -->
                    <TextView
                        android:id="@+id/tv_price_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="Mức giá bù trừ đề xuất từ bên yêu cầu trao đổi"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <!-- Layout ngang chứa phần tiền tệ và trường nhập giá -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Phần chứa chữ VNĐ với nền xanh -->
                        <TextView
                            android:id="@+id/tv_currency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@android:drawable/editbox_dropdown_dark_frame"
                            android:backgroundTint="@android:color/holo_blue_light"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="VNĐ"
                            android:textColor="@android:color/white"
                            android:textSize="16sp" />

                        <!-- Trường nhập giá -->
                        <EditText
                            android:id="@+id/et_price_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/background_stroke_around"
                            android:enabled="false"
                            android:fontFamily="@font/inter_semibold"
                            android:inputType="number"
                            android:padding="10dp"
                            android:textColor="@color/blue_btn_search"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Ghi chú -->
                    <TextView
                        android:id="@+id/tv_note_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="Ghi chú"
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_note"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@drawable/background_stroke_around"
                        android:enabled="false"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="10dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <!--// Do Nothing-->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="200dp"/>
            </LinearLayout>


        </LinearLayout>


    </ScrollView>


    <LinearLayout
        android:id="@+id/ll_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="9"
        app:layout_constraintBottom_toBottomOf="parent">

        <!--// Reject Button-->
        <LinearLayout
            android:id="@+id/btn_reject"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_margin="5dp"
            android:layout_weight="3"
            android:background="@drawable/ripple_effect_white"
            android:backgroundTint="@color/red_light"
            android:clickable="true"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Icon -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/baseline_cancel_24" />

            <!-- Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:gravity="center_vertical"
                android:text="Từ Chối"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <!--// Change Price Valuation Button-->
        <LinearLayout
            android:id="@+id/btn_price_valuation"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_margin="5dp"
            android:layout_weight="3"
            android:background="@drawable/ripple_effect_white"
            android:backgroundTint="@color/primaryColor"
            android:clickable="true"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Icon -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="Icon chọn ngày"
                android:src="@drawable/baseline_currency_exchange_24" />

            <!-- Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Thay Đổi Mức Giá"
                android:textAlignment="center"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>


        <!--// Approve Button-->
        <LinearLayout
            android:id="@+id/btn_approval"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_margin="5dp"
            android:layout_weight="3"
            android:background="@drawable/ripple_effect_white"
            android:backgroundTint="@color/blue_btn_search"
            android:clickable="true"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Icon -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Icon chọn ngày"
                android:src="@drawable/baseline_check_circle_24" />

            <!-- Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:gravity="center_vertical"
                android:text="Chấp Nhận"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>