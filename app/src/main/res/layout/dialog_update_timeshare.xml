<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ripple_effect"
    android:orientation="vertical"
    android:backgroundTint="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--// Do Nothing-->
            <View
                android:layout_marginTop="5dp"
                android:layout_gravity="center"
                android:layout_width="100dp"
                android:layout_height="5dp"
                android:backgroundTint="@color/gray_600"
                android:background="@drawable/background_stroke_around"/>

            <!--// Title-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textView34"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="CẬP NHẬT TIMESHARE"
                    android:textColor="@color/red_light"
                    android:textSize="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!--// Save Btn-->
                <LinearLayout
                    android:id="@+id/btn_save_update_posting"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="right"
                    android:background="@drawable/ripple_effect_white"
                    android:backgroundTint="@color/primaryColor"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Icon chọn ngày"
                        android:src="@drawable/baseline_save_24" />

                    <!-- Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center_vertical"
                        android:text="Cập Nhật Thông Tin"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>




            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--// Timehare Info-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!--// Yes Distribution-->
                <include
                    android:id="@+id/include_unit_type_yes"
                    layout="@layout/include_yes_distribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:visibility="visible" />

            </LinearLayout>

            <!--// Select Check in and Check out date-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/crl_day_check_in_info">

                <!-- Available Start Year -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Năm bắt đầu cho thuê &amp; trao đổi"
                            android:textColor="@android:color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_light"
                            android:text="Thời điểm bắt đầu hiệu lực giao dịch cho thuê hoặc trao đổi Timeshare của bạn"
                            android:textColor="@android:color/black"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="3"
                        app:strokeColor="@color/blue_btn_search"
                        app:strokeWidth="1dp">

                        <Spinner
                            android:id="@+id/sp_valid_star_year"
                            style="@style/CustomSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:spinnerMode="dialog" />

                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>

                <!-- Available Year -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Năm kết thúc hiệu lực Timeshare"
                            android:textColor="@android:color/black"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_light"
                            android:text="Thời điểm hết hạn sử dụng Timeshare."
                            android:textColor="@android:color/black"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="3"
                        app:strokeColor="@color/blue_btn_search"
                        app:strokeWidth="1dp">

                        <Spinner
                            android:id="@+id/sp_valid_end_year"
                            style="@style/CustomSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:spinnerMode="dialog" />

                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>


                <!--// Ngày nhận phòng-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Ngày nhận phòng, trả phòng của bạn"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_light"
                    android:text="Ngày nhận phòng, trả phòng của bạn sẽ được cố định trong suốt thời gian sử dụng Timeshare còn hiệu lưc."
                    android:textColor="@android:color/black"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/ll_check_in_out_date"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/white"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <!-- Check-in Date Section -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="4.5"
                        android:background="@drawable/ripple_effect_white"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!-- Label for Check-in Date -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_regular"
                                android:maxLines="1"
                                android:text="Ngày Nhận Phòng"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_check_in" />


                        </LinearLayout>


                        <!-- Check-in Date -->
                        <TextView
                            android:id="@+id/tv_checkin_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_bold"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <!-- Check-in Day -->

                        <TextView
                            android:id="@+id/tv_checkin_dayOfWeek"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_light"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Arrow Icon -->
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:src="@drawable/ic_arrow_right" /> <!-- Use your arrow drawable here -->

                    <!-- Check-out Date Section -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:layout_weight="4.5"
                        android:background="@drawable/ripple_effect_white"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!-- Label for Check-in Date -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_regular"
                                android:maxLines="1"
                                android:text="Ngày Trả Phòng"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_check_out" />

                        </LinearLayout>

                        <!-- Check-out Date -->
                        <TextView
                            android:id="@+id/tv_checkout_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_bold"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <!-- Check-out Day -->
                        <TextView
                            android:id="@+id/tv_checkout_dayOfWeek"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_light"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Select Date Button -->
                <LinearLayout
                    android:id="@+id/btn_select_check_in_out_date"
                    android:clickable="true"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:background="@drawable/ripple_effect"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/baseline_date_range_24"
                        android:contentDescription="Icon chọn ngày"
                        android:layout_marginEnd="8dp" />

                    <!-- Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chọn Ngày"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:gravity="center_vertical" />

                </LinearLayout>

                <!-- Nights Count Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Nights Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số đêm"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />

                    <!-- Nights Count Field -->
                    <TextView
                        android:id="@+id/etNightsCount"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:background="@color/primary_background_F9"
                        android:enabled="false"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="0"
                        android:textColor="@android:color/black"
                        android:textSize="16sp" />
                </LinearLayout>


            </LinearLayout>







        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



</LinearLayout>