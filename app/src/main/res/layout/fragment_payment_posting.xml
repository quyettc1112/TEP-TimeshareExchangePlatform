<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.Activity.PostingFlow.Fragment.Step_6_PaymentPostingFragment">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingTop="10dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!--// My Package-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_package_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <TextView
                            android:id="@+id/titleTv"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Thông tin gói dịch vụ"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textView20"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="@color/red_light"
                            android:textSize="20dp"
                            app:layout_constraintStart_toEndOf="@+id/titleTv"
                            app:layout_constraintTop_toTopOf="@+id/titleTv" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_change_my_package"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:background="@drawable/ripple_effect_white"
                            android:backgroundTint="@color/blue_btn_search"
                            android:text="Chỉnh sửa"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content UMy Timeshare-->
                    <LinearLayout
                        android:id="@+id/ll_content_my_timeshare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_package_info">

                        <include
                            android:id="@+id/include_packege_posting"
                            layout="@layout/item_package_posting"
                            android:visibility="visible" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--// My Detail Timeshare Billing-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_unit_type_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <TextView
                            android:id="@+id/textView17"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Thông tin Timeshare của bạn"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textView19"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="@color/red_light"
                            android:textSize="20dp"
                            app:layout_constraintStart_toEndOf="@+id/textView17"
                            app:layout_constraintTop_toTopOf="@+id/textView17" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content UMy Timeshare-->
                    <LinearLayout
                        android:id="@+id/ll_my_detail_billing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_unit_type_info">

                        <include
                            android:id="@+id/include_detail_billing"
                            layout="@layout/include_detail_billing"
                            android:visibility="visible" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>


            <!--// Include Exchange Time&ndash-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_exchange_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_exchange_time_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <TextView
                            android:id="@+id/textView200"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Thông tin Timeshare của bạn"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textView201"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="@color/red_light"
                            android:textSize="20dp"
                            app:layout_constraintStart_toEndOf="@+id/textView200"
                            app:layout_constraintTop_toTopOf="@+id/textView200" />

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <!--// Include Exchange Time-->
                    <LinearLayout
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/crl_exchange_time_info">
                        <include
                            android:id="@+id/include_exchange_time"
                            layout="@layout/include_exchange_ui"
                            android:visibility="visible" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>


            <!--// My Package-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_term_policy_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/textView21"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Các điều khoản và chính sách"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"
                            android:textColor="@color/red_light"
                            android:textSize="20dp"
                            app:layout_constraintStart_toEndOf="@+id/textView21"
                            app:layout_constraintTop_toTopOf="@+id/textView21" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content Policy-->
                    <TextView
                        android:id="@+id/tvAgreementText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center|left"
                        android:padding="16dp"
                        android:text="Khi tạo bài đăng này, bạn đồng ý với những điều sau:\n\nBạn là chủ sở hữu của căn hộ/tuần được mô tả, hoặc có quyền hợp pháp để kiểm soát nó.\n\nTất cả các chi tiết trong bài đăng này đều chính xác, theo sự đồng ý các mục bạn đã chọn.\n\nBạn sẽ phản hồi tất cả các thắc mắc qua email một cách kịp thời (trong vòng 48 giờ) và xóa bài đăng nếu không còn áp dụng."
                        android:textAlignment="gravity"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        app:layout_constraintTop_toBottomOf="@+id/crl_term_policy_info" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--// Policy Accept-->
            <LinearLayout
                android:id="@+id/ll_agreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <!-- CheckBox -->
                <CheckBox
                    android:id="@+id/cbAgreement"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp" />

                <!-- TextView for the Agreement Text -->
                <TextView
                    android:id="@+id/tvAgreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Tôi đã đọc và đồng ý với các điều khoản trên *"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!--// Bottom Payment Button-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_request_contaner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_stroke_around"
                    android:backgroundTint="@color/white"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="20dp">

                    <!--// Total Price-->
                    <LinearLayout
                        android:id="@+id/linearLayout23"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toTopOf="@+id/ctr_request_button"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <!-- Package Title -->
                        <TextView
                            android:id="@+id/tvPackageTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:text="GÓI ĐĂNG BÀI RENT000000"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Time Duration Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <!-- Label for Time -->
                            <TextView
                                android:id="@+id/tvTimeLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:text="Thời hạn đến"
                                android:textColor="@android:color/black"
                                android:textSize="14sp" />

                            <!-- Time Range -->
                            <TextView
                                android:id="@+id/tv_Duration_time"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:fontFamily="@font/inter_semibold"
                                android:text="11/09/2024 - 11/03/2025"
                                android:textAlignment="textEnd"
                                android:textColor="@android:color/black"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Fee Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <!-- Label for Posting Fee -->
                            <TextView
                                android:id="@+id/tvFeeLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:text="Phí đăng bài"
                                android:textColor="@android:color/black"
                                android:textSize="14sp" />

                            <!-- Posting Fee -->
                            <TextView
                                android:id="@+id/tvPostingFee"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:fontFamily="@font/inter_semibold"
                                android:text="₫990,000"
                                android:textAlignment="textEnd"
                                android:textColor="@android:color/black"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Total Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <!-- Label for Total -->
                            <TextView
                                android:id="@+id/tvTotalLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tổng"
                                android:textColor="@android:color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <!-- Total Amount -->
                            <TextView
                                android:id="@+id/tvTotalAmount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_extrabold"
                                android:text="₫1,360,000"
                                android:textAlignment="textEnd"
                                android:textColor="@android:color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!--// Payment Method-->
                    <LinearLayout
                        android:id="@+id/ll_payment_method"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal"
                        android:weightSum="10"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout23"
                        tools:layout_editor_absoluteX="20dp">

                        <!--// VNPay Button-->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_vnpay"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_margin="5dp"
                            android:layout_weight="5"
                            android:clickable="true"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp"
                            app:strokeWidth="2dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <!--// Image VNPay-->
                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardView6"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_marginStart="10dp"
                                    app:cardCornerRadius="50dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="12dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/ic_vnpay" />

                                </androidx.cardview.widget.CardView>

                                <!--// Text VNPay-->
                                <TextView
                                    android:id="@+id/textView22"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginEnd="5dp"
                                    android:fontFamily="@font/inter_semibold"
                                    android:maxLines="1"
                                    android:text="VNPay"
                                    android:textColor="@color/black"
                                    android:textSize="16dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/cardView6"
                                    app:layout_constraintTop_toTopOf="@+id/cardView6" />


                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginEnd="5dp"
                                    android:fontFamily="@font/inter_light"
                                    android:maxLines="1"
                                    android:text="Miễn Phí"
                                    android:textColor="@color/black"
                                    android:textSize="12dp"
                                    app:layout_constraintBottom_toBottomOf="@+id/cardView6"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/cardView6"
                                    app:layout_constraintTop_toBottomOf="@+id/textView22" />

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!--// Unwind Button-->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_unwind"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_margin="5dp"
                            android:layout_weight="5"
                            android:clickable="true"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp"
                            app:strokeWidth="2dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <!--// Image VNPay-->
                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardView7"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_marginStart="10dp"
                                    app:cardCornerRadius="50dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="16dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/ic_logo_only" />

                                </androidx.cardview.widget.CardView>

                                <!--// Text VNPay-->
                                <TextView
                                    android:id="@+id/textView23"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginEnd="5dp"
                                    android:fontFamily="@font/inter_semibold"
                                    android:maxLines="1"
                                    android:text="Ví Unwind"
                                    android:textColor="@color/black"
                                    android:textSize="16dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/cardView7"
                                    app:layout_constraintTop_toTopOf="@+id/cardView7" />


                                <TextView
                                    android:id="@+id/tv_wallet_balance"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginEnd="5dp"
                                    android:fontFamily="@font/inter_light"
                                    android:maxLines="1"
                                    android:text="259.000đ"
                                    android:textColor="@color/black"
                                    android:textSize="12dp"
                                    app:layout_constraintBottom_toBottomOf="@+id/cardView7"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/cardView7"
                                    app:layout_constraintTop_toBottomOf="@+id/textView23" />

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>


                    </LinearLayout>


                    <!--// Button Request-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ctr_request_button"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="#5F8BFF"
                        android:clickable="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ll_payment_method">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:layout_editor_absoluteX="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/inter_semibold"
                                android:text="Hoàn tất đặt đơn"
                                android:textColor="@color/white" />

                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>

