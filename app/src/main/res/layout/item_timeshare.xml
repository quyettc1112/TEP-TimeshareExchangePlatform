<?xml version="1.0" encoding="utf-8"?>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:background="@drawable/background_stroke_around"
        android:layout_marginEnd="15dp"
        android:layout_width="180dp"
        android:layout_height="260dp">

        <LinearLayout
            android:id="@+id/ll_verify"
            android:layout_width="90dp"
            android:layout_height="25dp"
            android:gravity="center"
            android:background="@drawable/background_verify"
            app:layout_constraintStart_toStartOf="parent"
            android:translationZ="10dp"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="center"
                android:text="@string/suggest_verify"
                android:textSize="7dp"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp">

            <ImageView
                android:id="@+id/im_favorite"
                android:layout_marginTop="8dp"
                android:layout_marginStart="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_favorite_border_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView" />


            <!-- // Image-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                app:cardCornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/yellow_stroke_image"
                app:strokeWidth="1dp">
                <ImageView
                    android:id="@+id/im_imageTimeshare"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/im_matiral_timeshare"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- // Off-->
            <!-- // Ratign-->
            <LinearLayout
                android:id="@+id/materialCardView3"
                android:layout_width="100dp"
                android:layout_height="22dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/background_rating"
                app:cardCornerRadius="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView"
                app:strokeColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center|left"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/baseline_star_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:gravity="center"
                        android:text="4.5"
                        android:textColor="#007EF2"
                        android:textSize="8dp" />

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:gravity="center"
                        android:text="254 đánh giá"
                        android:textSize="8dp" />
                </LinearLayout>


            </LinearLayout>

            <!--// TimeShare Detail-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:padding="5dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView3">

                <!-- // TimeShare name-->
                <TextView
                    android:id="@+id/tv_timeShreName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"
                    android:textSize="12dp"
                    android:maxLines="1"
                    android:text="Nha Trang Resort"/>

                <!-- // Location-->
                <LinearLayout
                    android:gravity="center|left"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:minHeight="20dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_location">
                    </ImageView>

                    <TextView
                        android:id="@+id/tv_location"
                        android:layout_marginStart="5dp"
                        android:textSize="10dp"
                        android:gravity="center|left"
                        android:text="Khánh Hòa, Việt Nam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- // Date-->
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:minHeight="20dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_schedule">
                    </ImageView>

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_marginStart="5dp"
                        android:textSize="10dp"
                        android:gravity="center|left"
                        android:text="26/08/2024 - 30/08/2024"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- // Room-->
                <LinearLayout
                    android:gravity="center|left"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:minHeight="20dp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_room_ts">
                    </ImageView>

                    <TextView
                        android:id="@+id/tv_room"
                        android:layout_marginStart="5dp"
                        android:textSize="10dp"
                        android:gravity="center|left"
                        android:text="Phòng Studio, 1 Giường, 4 Người"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!--// Price-->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.300.000 VND"
                        android:textSize="14dp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textColor="@color/blue_full"/>

                    <TextView
                        android:id="@+id/tv_numberOfNight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" | 4 đêm"
                        android:textSize="12dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/primary_stroke_around"/>

                </LinearLayout>







            </LinearLayout>






        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>



