<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background_F9">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--// Custom Toolbar-->
        <com.example.tep_timeshareexchangeplatform.AppConfig.CustomView.CustomToolbar.CustomToolbar
            android:id="@+id/customToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:title="Chi Tiết Bài Đăng"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:showStartText="false"
            app:showTitleDetail="true"
            app:titleDetail="Flamingo Dai Lai | Studio King" />
        <!--// Resort Status-->
    <LinearLayout
        android:id="@+id/ll_status_container"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/ripple_effect"
        android:backgroundTint="@color/white"
        android:padding="5dp"
        android:translationZ="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/scrollView">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:background="@color/white"
            android:saveEnabled="false"
            app:cardCornerRadius="100dp"
            app:strokeColor="@color/red_light"
            app:strokeWidth="8dp" />


        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/inter_bold"
            android:text="Đã xác nhận"
            android:textColor="@color/red_light"
            android:textSize="12dp" />
    </LinearLayout>
        <!--// Timeshare Detail-->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@+id/customToolbar">

            <!--// Layout Container for Timeshare Detail-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_background_F9"
                android:orientation="vertical">

                <!--// Timeshare Detail Image-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="250dp">

                    <!--// Image List-->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:maxWidth="360dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!--// Indicator-->
                    <me.relex.circleindicator.CircleIndicator3
                        android:id="@+id/indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/viewPager"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!--// Next To Button-->
                    <ImageView
                        android:id="@+id/icBackTo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_back_to"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <ImageView
                        android:id="@+id/ivNextPage"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_next_page"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/viewPager"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <!--// Resort Info and Map-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp">



                    <!--// Resort Name-->
                    <TextView
                        android:id="@+id/tvResortName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_extrabold"
                        android:textColor="@color/black"
                        android:textSize="20dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!--// Resort Type-->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/materialCardView4"
                        android:layout_width="90dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="15dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvResortName"
                        app:strokeColor="#20A3C9"
                        app:strokeWidth="2dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="Khách sạn"
                            android:textColor="#20A3C9" />

                    </com.google.android.material.card.MaterialCardView>


                    <!--// Location-->
                    <LinearLayout
                        android:id="@+id/linearLayout9"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="10"
                        app:layout_constraintTop_toBottomOf="@+id/materialCardView4"
                        tools:layout_editor_absoluteX="20dp">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="0.5"
                            android:src="@drawable/ic_location" />

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="9"
                            android:fontFamily="@font/inter_light"
                            android:maxLines="2"
                            android:paddingStart="5dp"
                            android:textSize="12sp" />


                    </LinearLayout>

                    <!--// Verify Button-->
                    <LinearLayout
                        android:id="@+id/llVerify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout9">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="0.5"
                            android:src="@drawable/ic_verify" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="9"
                            android:fontFamily="@font/inter_light"
                            android:maxLines="2"
                            android:paddingStart="5dp"
                            android:text="Đã được xác minh bởi Unwind"
                            android:textSize="12sp" />


                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <!--// Ngày nhận phòng-->
                <LinearLayout
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center"
                    android:weightSum="10"
                    android:orientation="horizontal">

                    <!-- Check-in Date Section -->
                    <LinearLayout
                        android:layout_weight="4.5"
                        android:layout_width="0dp"
                        android:background="@drawable/ripple_effect_white"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!-- Label for Check-in Date -->
                        <LinearLayout
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:fontFamily="@font/inter_regular"
                                android:text="Ngày Nhận Phòng"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp" />
                            <ImageView
                                android:src="@drawable/ic_check_in"
                                android:layout_width="20dp"
                                android:layout_height="match_parent"/>


                        </LinearLayout>


                        <!-- Check-in Date -->
                        <TextView
                            android:id="@+id/tv_checkin_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <!-- Check-in Day -->

                        <TextView
                            android:id="@+id/tv_checkin_dayOfWeek"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_light"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Arrow Icon -->
                    <ImageView
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_right" /> <!-- Use your arrow drawable here -->

                    <!-- Check-out Date Section -->
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_weight="4.5"
                        android:layout_width="0dp"
                        android:background="@drawable/ripple_effect_white"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <!-- Label for Check-in Date -->
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:fontFamily="@font/inter_regular"
                                android:text="Ngày Trả Phòng"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp" />
                            <ImageView
                                android:src="@drawable/ic_check_out"
                                android:layout_width="20dp"
                                android:layout_height="match_parent"/>

                        </LinearLayout>

                        <!-- Check-out Date -->
                        <TextView
                            android:id="@+id/tv_checkout_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <!-- Check-out Day -->
                        <TextView
                            android:id="@+id/tv_checkout_dayOfWeek"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_light"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!--// Detail Billing-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/include_detail_billing"
                        layout="@layout/include_detail_billing"
                        android:visibility="gone" />

                </LinearLayout>

                <!--// Unit Type-->
                <LinearLayout
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/include_unit_type"
                        layout="@layout/include_unit_type"
                        android:visibility="visible" />

                </LinearLayout>


                <!--// Facilities-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@color/white"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">
                    <!-- // Suggest Title-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayout7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="Những tiện nghi phổ biến nhất"
                            android:textColor="@color/black"
                            android:textSize="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Frame Layout Facilities-->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_resort_facilities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/constraintLayout7"
                        tools:layout_editor_absoluteX="20dp"
                        tools:listitem="@layout/item_facilitie" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!--// Package-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <include
                        android:visibility="gone"
                        android:id="@+id/include_package_posting"
                        layout="@layout/item_package_posting" />

                </LinearLayout>


                <!--// Do Nothing-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@color/white" />

            </LinearLayout>
        </ScrollView>



    </com.facebook.shimmer.ShimmerFrameLayout>

    <!--// Bottom Button-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_request_contaner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="10dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/primary_background"
        app:strokeWidth="1dp">
