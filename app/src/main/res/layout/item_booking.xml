<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/ripple_effect"
    android:backgroundTint="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="15dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--// Type Booking-->
    <LinearLayout
        android:id="@+id/ll_type_booking_container"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:elevation="3dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/im_booking_type"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:padding="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_rental_booking" />
        <TextView
            android:id="@+id/tv_booking_tupe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/inter_bold"
            android:text="Thuê Phòng"
            android:textColor="@color/blue_btn_search"
            android:textSize="10dp" />
    </LinearLayout>

    <!--// Image Timeshare-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView"
        android:layout_width="100dp"
        android:layout_height="120dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_type_booking_container"
        app:strokeColor="@color/yellow_stroke_image"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/im_imageTimeshare"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/im_matiral_timeshare" />
    </com.google.android.material.card.MaterialCardView>

    <!--//Timeshare name-->
    <TextView
        android:id="@+id/tv_timeshareName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:gravity="left"
        android:maxLines="2"
        android:textColor="@color/black"
        android:text="Flamingo Đại Lải Resort"
        android:textSize="16dp"
        app:layout_constraintEnd_toStartOf="@+id/materialCardView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_type_booking_container" />

    <!--// Room Type-->
    <TextView
        android:id="@+id/tv_timeshareType"
        android:gravity="left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:maxLines="2"
        android:text="Studio King asdasd as "
        android:textSize="12dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_timeshareName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_timeshareName" />

    <!-- // Check In Day-->
    <LinearLayout
        android:id="@+id/linearLayout38"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center|left"
        android:minHeight="20dp"
        android:orientation="horizontal"
        android:weightSum="10"
        app:layout_constraintEnd_toStartOf="@+id/materialCardView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_timeshareType">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_weight="1"
            android:src="@drawable/ic_check_in"
            android:visibility="gone" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:fontFamily="@font/inter_bold"
            android:gravity="center|left"
            android:maxLines="1"
            android:text="Nhận Phòng: "
            android:textSize="10dp" />

        <TextView
            android:id="@+id/tv_checkin_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="7"
            android:fontFamily="@font/inter_bold"
            android:gravity="center|left"
            android:maxLines="1"
            android:text="18/09/2024 - 20/09/2024"
            android:textColor="@color/black"
            android:textSize="12dp" />

    </LinearLayout>

    <!-- // Check Out Day-->
    <LinearLayout
        android:id="@+id/linearLayout39"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center|left"
        android:minHeight="20dp"
        android:orientation="horizontal"
        android:visibility="visible"
        android:weightSum="10"
        app:layout_constraintEnd_toStartOf="@+id/materialCardView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout38">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_weight="1"
            android:src="@drawable/ic_check_out"
            android:visibility="gone" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:fontFamily="@font/inter_bold"
            android:gravity="center|left"
            android:maxLines="1"
            android:text="Trả Phòng: "
            android:textSize="10dp" />

        <TextView
            android:id="@+id/tv_check_out_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="7"
            android:fontFamily="@font/inter_bold"
            android:gravity="center|left"
            android:maxLines="1"
            android:text="18/09/2024 - 20/09/2024"
            android:textColor="@color/black"
            android:textSize="12dp" />

    </LinearLayout>

    <!--// Resort Status-->
    <LinearLayout
        android:id="@+id/ll_status_container"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/ripple_effect"
        android:backgroundTint="@color/white"
        android:elevation="3dp"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout39">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:saveEnabled="false"
            app:cardCornerRadius="30dp"
            app:strokeColor="@color/red_light"
            app:strokeWidth="5dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/inter_extrabold"
            android:gravity="center"
            android:text="Đã xác nhận"
            android:textColor="@color/red_light"
            android:textSize="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_update_info"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ic_warning_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/redPrimary"
            android:textSize="12dp"
            android:fontFamily="@font/inter_semibold"
            android:text="Cập nhật thông tin" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>