<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_margin="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!-- Icon (location pin) -->
        <com.google.android.material.card.MaterialCardView
            android:gravity="center"
            android:backgroundTint="@color/primary_background_F9"
            app:cardCornerRadius="10dp"
            android:layout_width="50dp"
            android:layout_height="50dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/im_logo"
                android:scaleType="centerCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>


        <!-- Texts for City Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tv_resortName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thành Phố Đà Lạt"
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_location"
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lâm Đồng, Việt Nam"
                android:textColor="@color/gray_400" />
        </LinearLayout>

        <!-- Number of listings for the city -->
        <!--<TextView
            android:id="@+id/city_listings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1916"
            android:textColor="@color/black" />-->

    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="5dp"
        android:background="@color/primary_background_F9"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>



</LinearLayout>