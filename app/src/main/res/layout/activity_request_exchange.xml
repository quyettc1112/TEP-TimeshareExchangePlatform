<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.example.tep_timeshareexchangeplatform.AppConfig.CustomView.CustomToolbar.CustomToolbar
        android:id="@+id/customToolbar2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Gửi Yêu Cầu Trao Đổi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showStartText="false" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:fillViewport="true"
        android:paddingTop="10dp"
        android:layout_marginTop="50dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!--// Exchange Timeshare-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_unit_type_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">




                        <TextView
                            android:id="@+id/titleTv"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Thông tin Timeshare trao đổi"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content UMy Timeshare-->
                    <LinearLayout
                        android:id="@+id/ll_content_exchange_timshare"
                        android:layout_width="0dp"
                        android:paddingTop="15dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_unit_type_info">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/animation_view_exchange"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:lottie_rawRes="@raw/anim_loading_more"
                            app:lottie_loop="true"
                            app:lottie_autoPlay="true"/>
                        <include
                            android:visibility="gone"
                            android:id="@+id/include_exchange_timehare"
                            layout="@layout/item_my_timeshare" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--// Exchange Timeshare-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ll_my_timeshare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_my_timeshare_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">




                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Thông tin Timeshare trao đổi của bạn"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content UMy Timeshare-->
                    <LinearLayout
                        android:id="@+id/ll_content_my_timeshare"
                        android:layout_width="0dp"
                        android:paddingTop="15dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_my_timeshare_info">

                        <LinearLayout
                            android:id="@+id/ll_add_my_timeshare"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.airbnb.lottie.LottieAnimationView
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                app:lottie_rawRes="@raw/anim_choose_timesahre"
                                app:lottie_loop="true"
                                app:lottie_autoPlay="true"/>
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_add_my_timeshare"
                                android:background="@drawable/ripple_effect_white"
                                android:backgroundTint="@color/blue_see_more"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:text="Chọn Timeshare trao đổi của bạn"
                                android:layout_marginStart="50dp"
                                android:layout_marginEnd="50dp"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginBottom="10dp"/>

                        </LinearLayout>

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/animation_view_my_timeshare"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:lottie_rawRes="@raw/anim_loading_more"
                            app:lottie_loop="true"
                            app:lottie_autoPlay="true"/>

                        <include
                            android:visibility="gone"
                            android:id="@+id/include_my_timeshare"
                            layout="@layout/item_my_timeshare" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--// Select Check in and Check out date-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ll_valid_year"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_day_check_in_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Năm hoạt động khả dụng Timeshare của bạn"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content Check In Day-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_day_check_in_info">

                        <LinearLayout
                            android:id="@+id/llCheckInCheckOut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:visibility="visible">

                            <!--// Valid Year Selection-->
                            <TextView
                                android:id="@+id/tv_valid_year_selection"
                                android:layout_gravity="left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Năm hoạt động khả dụng"
                                android:textColor="@android:color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/custom_spinner_year_valid"
                                style="@style/CustomSpinner"
                                android:layout_width="match_parent"
                                android:layout_marginTop="10dp"
                                android:layout_height="60dp"
                                android:spinnerMode="dialog"
                                android:elevation="2dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:layout_gravity="left"
                                android:padding="5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/valid_year_description"
                                android:fontFamily="@font/inter_light"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <!-- Date Selection Container -->
                            <LinearLayout
                                android:id="@+id/llCheckInCheckOutComp"
                                android:layout_marginTop="15dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/background_stroke_around"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="3dp">

                                <!-- Check-In Section -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">


                                    <!-- Check-In Label -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ngày Nhận Phòng"
                                        android:textColor="@android:color/black"
                                        android:textSize="14sp" />

                                    <!-- Check-In Date -->
                                    <TextView
                                        android:id="@+id/tvCheckInDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_extrabold"
                                        android:textColor="@android:color/black"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <!-- Check-In Day -->
                                    <TextView
                                        android:id="@+id/tvCheckInDayOfWeek"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@android:color/darker_gray"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <!-- Arrow between Check-In and Check-Out -->
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_arrow_right" />

                                <!-- Check-Out Section -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <!-- Check-Out Label -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ngày Trả Phòng"
                                        android:textColor="@android:color/black"
                                        android:textSize="14sp" />

                                    <!-- Check-Out Date -->
                                    <TextView
                                        android:id="@+id/tvCheckOutDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_extrabold"
                                        android:textColor="@android:color/black"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <!-- Check-Out Day -->
                                    <TextView
                                        android:id="@+id/tvCheckOutDayOfWeek"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@android:color/darker_gray"
                                        android:textSize="14sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Nights Count Section -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- Nights Label -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Số đêm"
                                    android:textColor="@android:color/black"
                                    android:textSize="16sp" />

                                <!-- Nights Count Field -->
                                <TextView
                                    android:id="@+id/etNightsCount"
                                    android:layout_width="100dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_marginLeft="16dp"
                                    android:background="@color/primary_background_F9"
                                    android:enabled="false"
                                    android:fontFamily="@font/inter_bold"
                                    android:gravity="center"
                                    android:padding="8dp"
                                    android:text="0"
                                    android:textColor="@android:color/black"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>


                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--// Exchange Price Valuation-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ll_exchange_method"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayout17"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Chọn phương thức trao đổi"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Exchange Price Valuation-->
                    <LinearLayout
                        android:id="@+id/ll_exchange_price_valuation"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">


                        <RadioGroup
                            android:id="@+id/radioGroupExchangeOptions"
                            android:layout_marginTop="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/radioNoPaymentNeeded"
                                android:layout_width="match_parent"
                                android:layout_height="25dp"
                                android:text="Không bù tiền" />

                            <TextView
                                android:id="@+id/tvNoPaymentNeededDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cả hai bên không cần thanh toán thêm khoản tiền nào để thực hiện trao đổi."
                                android:paddingStart="10dp"
                                android:textSize="12sp"
                                android:textColor="?attr/colorSecondary" />


                            <RadioButton
                                android:id="@+id/radioPayDifferenceToOwner"
                                android:layout_marginTop="15dp"
                                android:layout_width="match_parent"
                                android:layout_height="25dp"
                                android:text="Bù tiền cho chủ sở hữu" />

                            <TextView
                                android:id="@+id/tvPayDifferenceToOwnerDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Bạn sẽ thanh toán số tiền chênh lệch để hoàn tất trao đổi."
                                android:paddingStart="10dp"
                                android:textSize="12sp"
                                android:textColor="?attr/colorSecondary" />

                            <RadioButton
                                android:id="@+id/radioOwnerPaysDifference"
                                android:layout_marginTop="15dp"
                                android:layout_width="match_parent"
                                android:layout_height="25dp"
                                android:text="Chủ sở hữu bù tiền" />

                            <TextView
                                android:id="@+id/tvOwnerPaysDifferenceDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Chủ sở hữu sẽ thanh toán số tiền chênh lệch để hoàn tất trao đổi."
                                android:paddingStart="10dp"
                                android:textSize="12sp"
                                android:textColor="?attr/colorSecondary" />


                        </RadioGroup>


                        <!-- Layout chứa phần tiền tệ và trường nhập giá -->
                        <LinearLayout
                            android:id="@+id/ll_price_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center|left"
                            android:orientation="vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilRoomPrice"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                app:helperTextTextColor="@android:color/holo_red_dark"
                                android:focusable="true"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_bias="0.0"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvRoomPriceSubtitle">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etRoomPrice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="50dp"
                                    android:hint="Nhập Giá Bù Tiền"
                                    android:textColor="@color/black"
                                    android:fontFamily="@font/inter_extrabold"
                                    android:maxLines="1"
                                    android:inputType="numberDecimal"
                                    android:padding="12dp"
                                    />
                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:id="@+id/ll_payment_method_12"
                                android:layout_marginStart="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                android:weightSum="2"
                                app:layout_constraintTop_toBottomOf="@+id/tilRoomPrice">

                                <!-- Input for Room Price -->
                                <EditText
                                    android:id="@+id/et_total_price"
                                    android:layout_width="0dp"
                                    android:layout_marginTop="15dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.5"
                                    android:background="@drawable/background_stroke_around"
                                    android:backgroundTint="@color/primary_background_F9"
                                    android:enabled="false"
                                    android:hint="Giá tiền cho tổng số đêm"
                                    android:inputType="numberDecimal"
                                    android:padding="12dp" />

                            </LinearLayout>


                        </LinearLayout>



                    </LinearLayout>

                    <!--// Description-->
                    <LinearLayout
                        android:background="@color/white"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!-- Nights Label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left"
                            android:fontFamily="@font/inter_bold"
                            android:text="Ghi Chú"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etNote"
                            android:enabled="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/background_stroke_around"
                            android:gravity="top|start"
                            android:inputType="text|textShortMessage"
                            android:minHeight="100dp"
                            android:padding="10dp"
                            android:textSize="14dp" />


                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:background="@drawable/ripple_effect_white"
        android:backgroundTint="@color/blue_btn_search"
        android:text="Tiếp theo"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/scrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

