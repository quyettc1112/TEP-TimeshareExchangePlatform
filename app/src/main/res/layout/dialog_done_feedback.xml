<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_margin="20dp"
    android:backgroundTint="@color/white"
    android:padding="20dp"
    android:background="@drawable/ripple_effect_white"
    android:gravity="center">

    <!-- Success Icon -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_failed_icon"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/anim_post_feebback_success"
        android:layout_width="wrap_content"
        android:layout_height="300dp"/>

    <!-- Success Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gửi phản hồi thành công"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp" />

    <!-- Success Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Cảm ơn bạn đã góp ý. Chúng tôi sẽ cố gắng cải thiện dịch vụ của mình."
        android:textSize="14sp"
        android:fontFamily="@font/inter_light"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp" />


    <!-- Confirmation Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirm"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Xác nhận"
        android:background="@drawable/ripple_effect_white"
        android:backgroundTint="@color/red_light"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

</LinearLayout>
