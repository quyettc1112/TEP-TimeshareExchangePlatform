<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.Activity.UserActivity.MyTransactionActivity.ui.main.PlaceholderFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_margin="10dp"
        android:paddingBottom="60dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_transaction" />
    <LinearLayout
        android:id="@+id/ll_loading"
        android:background="@color/primary_background_F9"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include android:id="@+id/include_loading" layout="@layout/my_progress_dialog_layout" />
    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>