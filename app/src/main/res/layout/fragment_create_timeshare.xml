<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".UI.Activity.FlowPosting.RentalPostingActivity.Fragment.Step_2_CreateTimeshareFragment">

    <ScrollView
        android:id="@+id/scrollView3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/primary_background_F9"
        android:fillViewport="true">

        <!--// Content-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--// Timeshare Resort Location -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/llResortLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <!-- Title Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bạn đang cho thuê Timeshare tại:"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Text Section -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical">

                            <!-- Location Title -->
                            <TextView
                                android:id="@+id/tvResortName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="Hyatt Hig Sierra Lodge asda asdasdas"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- Location Subtitle -->
                            <TextView
                                android:id="@+id/tvLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="Incline Village, Nevadadasdasd"
                                android:textColor="@color/gray_400"
                                android:textSize="14sp" />

                            <!-- Change Button -->
                            <TextView
                                android:id="@+id/tvChangeLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="✏️ Thay đổi"
                                android:textColor="@color/teal_700" />
                        </LinearLayout>

                        <!-- Image Section -->

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            app:cardCornerRadius="12dp">

                            <ImageView
                                android:id="@+id/ivResortImage"
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im_meterial_da_nang" />

                        </com.google.android.material.card.MaterialCardView>


                    </LinearLayout>

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="90dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_select_resort_location"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_margin="20dp"
                        android:background="@drawable/ripple_effect_white"
                        android:fontFamily="@font/inter_bold"
                        android:text="Chọn Resort có Timeshare bạn muốn cho thuê"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_background"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!--// Check Phân Bổ Phòng-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/crl_room_distribution"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_room_distribution_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="1. Kiểm tra mã phòng của bạn"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Container for Room Distribution-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="20dp"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:visibility="visible"
                        app:layout_constraintTop_toBottomOf="@+id/crl_room_distribution_info">

                        <!--// Titte Ask -->
                        <TextView
                            android:id="@+id/textView25"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:maxLines="2"
                            android:text="Bạn đã được phân bổ mã phòng từ Resort chưa?"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!--// Yes Button-->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_yes_room_distribution"
                            android:textColor="@color/white"
                            android:text="Có, tôi đã nhận được mã phòng từ Resort."
                            android:textAllCaps="false"
                            android:layout_marginTop="10dp"
                            android:layout_width="0dp"
                            android:layout_height="35dp"
                            android:background="@drawable/ripple_effect_white"
                            android:backgroundTint="@color/blue_full"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView25" />


                        <!--// No Button-->

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_no_room_distribution"
                            android:layout_marginTop="10dp"
                            android:layout_width="0dp"
                            android:layout_height="35dp"
                            android:background="@drawable/ripple_effect_white"
                            android:backgroundTint="#B0BEC5"
                            android:text="Không, tôi sẽ tự thiêt lập phòng của mình."
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/btn_yes_room_distribution" />


                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>



            </com.google.android.material.card.MaterialCardView>

            <!--// Unit Room-->
            <include
                android:id="@+id/include_unit_type"
                android:visibility="gone"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                layout="@layout/include_yes_distribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!--// Select Check in and Check out date-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/crl_day_check_in"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_day_check_in_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="3. Ngày check in"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content Unit Type-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible"
                        android:padding="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_day_check_in_info">

                        <!-- Date Selection Container -->
                        <LinearLayout
                            android:id="@+id/llCheckInCheckOutDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/background_stroke_around"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <!-- Check-In Section -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">


                                <!-- Check-In Label -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ngày Check In"
                                    android:textColor="@android:color/black"
                                    android:textSize="14sp" />

                                <!-- Check-In Date -->
                                <TextView
                                    android:id="@+id/tvCheckInDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="19-08-2024"
                                    android:textColor="@android:color/black"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <!-- Check-In Day -->
                                <TextView
                                    android:id="@+id/tvCheckInDayOfWeek"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Thứ 2"
                                    android:textColor="@android:color/darker_gray"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <!-- Arrow between Check-In and Check-Out -->
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_arrow_right" />

                            <!-- Check-Out Section -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <!-- Check-Out Label -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ngày Check Out"
                                    android:textColor="@android:color/black"
                                    android:textSize="14sp" />

                                <!-- Check-Out Date -->
                                <TextView
                                    android:id="@+id/tvCheckOutDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="19-08-2024"
                                    android:textColor="@android:color/black"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <!-- Check-Out Day -->
                                <TextView
                                    android:id="@+id/tvCheckOutDayOfWeek"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Thứ 2"
                                    android:textColor="@android:color/darker_gray"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Nights Count Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Nights Label -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Số đêm"
                                android:textColor="@android:color/black"
                                android:textSize="16sp" />

                            <!-- Nights Count Field -->
                            <TextView
                                android:id="@+id/etNightsCount"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginLeft="16dp"
                                android:background="@color/primary_background_F9"
                                android:enabled="false"
                                android:fontFamily="@font/inter_bold"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="0"
                                android:textColor="@android:color/black"
                                android:textSize="16sp" />
                        </LinearLayout>


                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--// List Amenities-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/crl_content_amenities"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_amenities_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="4. Tiện ích phòng"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content Amenti Type-->
                    <androidx.constraintlayout.widget.ConstraintLayout

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_amenities_info">

                        <!--// List of Amenities Kichen-->
                        <TextView
                            android:id="@+id/textView13"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="Bếp"
                            android:textSize="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAmenities"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            app:layout_constraintTop_toBottomOf="@+id/textView13" />

                        <!--// List of Amenities Entertaemnt-->
                        <TextView
                            android:id="@+id/textView14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="Giải trí"
                            android:textSize="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/rvAmenities" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAmenities_entertainment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            app:layout_constraintTop_toBottomOf="@+id/textView14" />

                        <!--// List of Policy-->
                        <TextView
                            android:id="@+id/textView15"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="Chính sách"
                            android:textSize="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/rvAmenities_entertainment" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPolicy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            app:layout_constraintTop_toBottomOf="@+id/textView15" />

                        <!--// Description-->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            app:layout_constraintTop_toBottomOf="@+id/rvPolicy">

                            <!-- Label -->
                            <TextView
                                android:id="@+id/labelDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Mô tả phòng"
                                android:textColor="@color/black"
                                android:textSize="16sp" />

                            <!-- Rounded EditText -->
                            <EditText
                                android:id="@+id/descriptionEditText"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:background="@drawable/background_stroke_around"
                                android:gravity="top|start"
                                android:hint="Nhập mô tả phòng..."
                                android:inputType="textMultiLine"
                                android:maxLines="5"
                                android:padding="12dp"
                                android:scrollbars="vertical"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--// List Image-->
            <com.google.android.material.card.MaterialCardView
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/crl_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_image_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_add_image"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:background="@drawable/background_stroke_around"
                            android:backgroundTint="@color/blue_btn_search"
                            android:text="Thêm ảnh"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <TextView
                            android:id="@+id/textView16"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Hình ảnh phòng"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content Image -->
                    <androidx.constraintlayout.widget.ConstraintLayout

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_image_info">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvImage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/background_stroke_around"
                            android:minHeight="150dp"
                            android:nestedScrollingEnabled="false"
                            android:paddingTop="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--// Do Nothing-->
            <LinearLayout
                android:layout_width="match_parent"
