<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".UI.Activity.FlowPosting.RentalPostingActivity.Fragment.Step_2_CreateTimeshareFragment">

    <ScrollView
        android:background="@color/primary_background_F9"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

       <!--// Content-->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!--// Timeshare Resort Location -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/llResortLocation"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Title Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bạn đang cho thuê Timeshare tại:"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <!-- Text Section -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical">

                            <!-- Location Title -->
                            <TextView
                                android:id="@+id/tvResortName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="Hyatt Hig Sierra Lodge asda asdasdas"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:textColor="@color/black"/>

                            <!-- Location Subtitle -->
                            <TextView
                                android:id="@+id/tvLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="Incline Village, Nevadadasdasd"
                                android:textSize="14sp"
                                android:textColor="@color/gray_400"/>

                            <!-- Change Button -->
                            <TextView
                                android:id="@+id/tvChangeLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✏️ Thay đổi"
                                android:textColor="@color/teal_700"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- Image Section -->

                        <com.google.android.material.card.MaterialCardView
                            app:cardCornerRadius="12dp"
                            android:layout_width="90dp"
                            android:layout_height="90dp">
                            <ImageView
                                android:id="@+id/ivResortImage"
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/im_meterial_da_nang"/>

                        </com.google.android.material.card.MaterialCardView>


                    </LinearLayout>

                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="90dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_select_resort_location"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_margin="20dp"
                        android:background="@drawable/ripple_effect_white"
                        android:fontFamily="@font/inter_bold"
                        android:text="Chọn Resort có Timeshare bạn muốn cho thuê"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_background"
                        android:textSize="14dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!--// Unit Room-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="17dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_unit_type_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardView"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            app:cardCornerRadius="100dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/im_expanded"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_expend" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/titleTv"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="Thông tin phòng của bạn"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content Unit Type-->
                    <LinearLayout
                        android:id="@+id/ll_content_unit_type"
                        android:layout_width="0dp"
                        android:visibility="gone"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_unit_type_info" >

                        <!-- Verified Room Info Text -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thông tin phòng đã được xác minh"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black" />

                        <!-- Dropdown for Bed Selection -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/textView11"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="Giường"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="*"
                                android:textColor="@color/red_light"
                                android:textSize="20sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/textView11"
                                app:layout_constraintTop_toTopOf="parent" />

                            <Spinner
                                android:id="@+id/custom_spinner_bed"
                                style="@style/CustomSpinner"
                                tools:listitem="@layout/support_simple_spinner_dropdown_item"
                                android:layout_width="100dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:spinnerMode="dropdown"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!--// List of Bed Type-->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvBedType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>

                        <!-- Dropdown for room direction -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/textView12"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="Hướng quan sát của phòng"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="*"
                                android:textColor="@color/red_light"
                                android:textSize="20sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/textView12"
                                app:layout_constraintTop_toTopOf="parent" />

                            <Spinner
                                android:id="@+id/custom_spinner_view_diretion"
                                style="@style/CustomSpinner"
                                tools:listitem="@layout/support_simple_spinner_dropdown_item"
                                android:layout_width="100dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:spinnerMode="dropdown"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Input for house number or unit -->
                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:hint="Số toà nhà/Số đơn vị (nếu đã được phân bổ)"
                            android:inputType="text" />


                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--// Select Check in and Check out date-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="17dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_day_check_in_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.cardview.widget.CardView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            app:cardCornerRadius="100dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_expend" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="Ngày check in"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--// Content Unit Type-->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:visibility="visible"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_day_check_in_info" >
                        <LinearLayout
                            android:visibility="gone"
                            android:id="@+id/llCheckInCheckOut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:background="@android:color/white"
                            android:gravity="center">

                            <!-- Date Selection Container -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="8dp"
                                android:background="@drawable/background_stroke_around"
                                android:gravity="center_vertical">

                                <!-- Check-In Section -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal">


                                    <!-- Check-In Label -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ngày Check In"
                                        android:textSize="14sp"
                                        android:textColor="@android:color/black"/>

                                    <!-- Check-In Date -->
                                    <TextView
                                        android:id="@+id/tvCheckInDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="19-08-2024"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="@android:color/black"/>

                                    <!-- Check-In Day -->
                                    <TextView
                                        android:id="@+id/tvCheckInDay"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Thứ 2"
                                        android:textSize="14sp"
                                        android:textColor="@android:color/darker_gray"/>
                                </LinearLayout>

                                <!-- Arrow between Check-In and Check-Out -->
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_arrow_right"
                                    android:layout_gravity="center"/>

                                <!-- Check-Out Section -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center_horizontal">

                                    <!-- Check-Out Label -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ngày Check Out"
                                        android:textSize="14sp"
                                        android:textColor="@android:color/black"/>

                                    <!-- Check-Out Date -->
                                    <TextView
                                        android:id="@+id/tvCheckOutDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="19-08-2024"
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="@android:color/black"/>

                                    <!-- Check-Out Day -->
                                    <TextView
                                        android:id="@+id/tvCheckOutDay"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Thứ 2"
                                        android:textSize="14sp"
                                        android:textColor="@android:color/darker_gray"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Nights Count Section -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="16dp"
                                android:gravity="center_vertical">

                                <!-- Nights Label -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Số đêm"
                                    android:textSize="16sp"
                                    android:textColor="@android:color/black"/>

                                <!-- Nights Count Field -->
                                <EditText
                                    android:id="@+id/etNightsCount"
                                    android:layout_width="100dp"
                                    android:gravity="center"
                                    android:text="0"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:background="@color/primary_background_F9"
                                    android:hint="0"
                                    android:fontFamily="@font/inter_bold"
                                    android:padding="8dp"
                                    android:textSize="16sp"
                                    android:enabled="false"
                                    android:textColor="@android:color/black"
                                    android:layout_marginLeft="16dp"/>
                            </LinearLayout>
                        </LinearLayout>



                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--// List Amenities-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="17dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_amenities_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.cardview.widget.CardView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            app:cardCornerRadius="100dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_expend" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="Tiện ích phòng"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <!--// Content Amenti Type-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ll_content_amenities"
                        android:layout_width="0dp"
                        android:visibility="gone"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_amenities_info" >

                        <!--// List of Amenities Kichen-->
                        <TextView
                            android:id="@+id/textView13"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="Bếp"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="15dp"
                            android:textSize="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAmenities"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            app:layout_constraintTop_toBottomOf="@+id/textView13" />

                        <!--// List of Amenities Entertaemnt-->
                        <TextView
                            android:id="@+id/textView14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="15dp"
                            android:text="Giải trí"
                            android:textSize="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/rvAmenities" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAmenities_entertainment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            app:layout_constraintTop_toBottomOf="@+id/textView14" />


                        <!--// List of Policy-->
                        <TextView
                            android:id="@+id/textView15"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="15dp"
                            android:text="Chính sách"
                            android:textSize="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/rvAmenities_entertainment" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPolicy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            app:layout_constraintTop_toBottomOf="@+id/textView15" />

                        <!--// Description-->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            app:layout_constraintTop_toBottomOf="@+id/rvPolicy">

                            <!-- Label -->
                            <TextView
                                android:id="@+id/labelDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Mô tả phòng"
                                android:textColor="@color/black"
                                android:textSize="16sp" />

                            <!-- Rounded EditText -->
                            <EditText
                                android:id="@+id/descriptionEditText"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:background="@drawable/background_stroke_around"
                                android:gravity="top|start"
                                android:hint="Nhập mô tả phòng..."
                                android:inputType="textMultiLine"
                                android:maxLines="5"
                                android:padding="12dp"
                                android:scrollbars="vertical"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                        </LinearLayout>



                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!--// List Image-->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="17dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <!--// Title Text-->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/crl_image_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ripple_effect_white"
                        android:backgroundTint="@color/blue_header_section"
                        android:padding="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_add_image"
                            android:layout_width="100dp"
                            android:layout_height="35dp"
                            android:layout_marginEnd="10dp"
                            android:textAllCaps="false"
                            android:text="Thêm ảnh"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/blue_btn_search"
                            android:background="@drawable/background_stroke_around"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/cardView4"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardView4"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            app:cardCornerRadius="100dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_expend" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/textView16"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_medium"
                            android:maxWidth="300dp"
                            android:padding="5dp"
                            android:text="Hình ảnh phòng"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <!--// Content Image -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ll_image"
                        android:layout_width="0dp"
                        android:visibility="gone"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/crl_image_info" >

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvImage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/background_stroke_around"
                            android:minHeight="150dp"
                            android:nestedScrollingEnabled="false"
                            android:paddingTop="10dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>