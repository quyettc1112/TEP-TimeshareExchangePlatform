<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Blog Image -->
        <ImageView
            android:id="@+id/img_blog_detail"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/pro_gradient" />

        <!-- Blog Title -->
        <TextView
            android:id="@+id/tv_blog_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_bold"
            android:text="Full Blog Title"
            android:textColor="@color/black"
            android:textSize="22sp" />

        <!-- Published Date -->
        <TextView
            android:id="@+id/tv_blog_detail_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:text="Published: 16 Nov 2024"
            android:textColor="@color/gray_400"
            android:textSize="14sp" />

        <!-- Blog Content -->
        <TextView
            android:id="@+id/tv_blog_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_regular"
            android:text="This is the full content of the blog post. It contains all the information that the user wants to read about this specific topic. Add paragraphs, images, or other elements as needed."
            android:textColor="@color/gray_600"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
