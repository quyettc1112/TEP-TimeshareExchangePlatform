<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--// Content Unit Type-->
    <LinearLayout
        android:id="@+id/linearLayout19"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- Dropdown for Bed Selection -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <!--// Room Code Search Container-->
            <LinearLayout
                android:id="@+id/ll_room_search_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/inter_bold"
                    android:text="Mã phòng"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="Chọn mã Phòng hoặc nhập mã phòng của bạn ở ô tìm kiếm"
                    android:textColor="@color/black"
                    android:textSize="14sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="10">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_view_contianer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="6.5"
                            app:strokeColor="@color/blue_btn_search"
                            app:strokeWidth="3dp">

                            <Spinner
                                android:id="@+id/sp_unit_type"
                                style="@style/CustomSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:spinnerMode="dialog" />

                        </com.google.android.material.card.MaterialCardView>
                        <!-- Search Input -->
                        <EditText
                            android:id="@+id/etRoomSearch"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="3.5"
                            android:background="@drawable/background_stroke_around"
                            android:hint="Nhập Mã Phòng"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:padding="12dp"
                            android:textSize="14dp" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!--// Room Search Result-->
            <LinearLayout
                android:id="@+id/ll_room_search_results"
                android:translationZ="10dp"
                android:background="@drawable/background_stroke_around"
                android:backgroundTint="@color/i_blue_light"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:maxHeight="300dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_room_search_container">

                <!-- RecyclerView for search results -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRoomResults"
                    android:padding="10dp"
                    android:nestedScrollingEnabled="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!--// Room Info-->
            <LinearLayout
                android:id="@+id/ll_unity_type_detail"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_effect_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_room_search_container">

                <!--// Code Phòng-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:weightSum="10">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="3"
                        android:fontFamily="@font/inter_bold"
                        android:text="Mã Phòng: "
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_room_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="7"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="16sp" />


                </LinearLayout>

                <!--// Tên Phòng-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="3"
                        android:fontFamily="@font/inter_bold"
                        android:text="Tên Phòng: "
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_room_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="7"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="16sp" />


                </LinearLayout>


                <include
                    android:id="@+id/include_item_unit_type"
                    layout="@layout/item_resort_room_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible" />


            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_processbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary_background_F9"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminate="true">

        </ProgressBar>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>


