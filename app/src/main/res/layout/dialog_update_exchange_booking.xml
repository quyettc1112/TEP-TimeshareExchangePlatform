<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:background="@drawable/ripple_effect"
        android:backgroundTint="@color/white"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textSize="14dp"
                android:text="Cập Nhật Thông Tin \nKhách Nhận Phòng"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/im_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:layout_margin="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--// Animation Lottie-->
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:lottie_rawRes="@raw/anim_update_booking_exchange"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>

        <!--// Customer Info-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <!--// Full Name-->
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:text="Tên đầy đủ"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/tv_full_name_in"
                    android:background="@drawable/background_stroke_around"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="7"
                    android:paddingStart="10dp"
                    android:gravity="left|center"
                    android:inputType="text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!--// Phone -->
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:text="Số điện thoại"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/tv_phone"
                    android:background="@drawable/background_stroke_around"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="7"
                    android:inputType="phone"
                    android:paddingStart="10dp"
                    android:gravity="left|center"
                    android:textSize="14sp" />
            </LinearLayout>


            <!--// Address-->
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:text="Email"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/tv_email"
                    android:background="@drawable/background_stroke_around"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="7"
                    android:paddingStart="10dp"
                    android:gravity="left|center"
                    android:inputType="textEmailAddress"
                    android:maxLines="2"
                    android:textSize="14sp" />
            </LinearLayout>



            <LinearLayout
                android:id="@+id/btn_save_info"
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:background="@drawable/ripple_effect_white"
                android:backgroundTint="@color/primaryColor"
                android:clickable="true"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Icon -->
                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Icon chọn ngày"
                    android:src="@drawable/ic_save" />

                <!-- Text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center_vertical"
                    android:text="Lưu thông tin"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>


</FrameLayout>

