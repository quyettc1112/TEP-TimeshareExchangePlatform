<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".UI.Activity.MainActivity.Fragment.AccountFragment.AccountFragment">

    <!-- // User Info Container-->
    <com.example.tep_timeshareexchangeplatform.AppConfig.CustomView.CustomToolbar.CustomToolbar
        android:id="@+id/toolblarCustome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:title="@string/profile_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showEndIcon="false"
        app:showShadow="false"
        app:showStartIcon="false"
        app:showStartText="false" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolblarCustome">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_background"
            android:gravity="center"
            android:orientation="vertical">

            <!--// Option Container-->
            <LinearLayout
                android:id="@+id/ll_customer_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="vertical">


                <!--// User Avatar-->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_user_avt"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ic_user_default_avt"
                    android:translationZ="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.151"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

                <!--   // Member Ship Contaner-->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ll_membership"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--// User Name-->
                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_extrabold"
                        android:text="Trần Cương Quyết"
                        android:textSize="20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!--// Membership Animation-->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/anim_membership"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_user_name"
                        app:layout_constraintEnd_toStartOf="@+id/tv_user_name"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/anim_membership" />

                    <LinearLayout
                        android:id="@+id/card_wallet_container"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center|top"
                        android:minHeight="70dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_user_name">

                        <!--// Wallet Container -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="55dp"
                            android:layout_marginTop="10dp"
                            android:clickable="true"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="5dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_user_name"
                            app:strokeWidth="2dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:minWidth="210dp">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardView7"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="10dp"
                                    app:cardCornerRadius="50dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="16dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/ic_logo_only" />

                                </androidx.cardview.widget.CardView>

                                <TextView
                                    android:id="@+id/textView23"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginEnd="10dp"
                                    android:fontFamily="@font/inter_semibold"
                                    android:maxLines="1"
                                    android:text="Ví Unwind"
                                    android:textColor="@color/black"
                                    android:textSize="12dp"
                                    app:layout_constraintStart_toEndOf="@+id/cardView7"
                                    app:layout_constraintTop_toTopOf="@+id/cardView7" />


                                <TextView
                                    android:id="@+id/tv_balance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginEnd="10dp"
                                    android:fontFamily="@font/inter_bold"
                                    android:maxLines="1"
                                    android:text="500.000 đ"
                                    android:textColor="@color/black"
                                    android:textSize="16dp"
                                    app:layout_constraintBottom_toBottomOf="@+id/cardView7"
                                    app:layout_constraintEnd_toStartOf="@+id/btn_deposit"
                                    app:layout_constraintHorizontal_bias="0.0"
                                    app:layout_constraintStart_toEndOf="@+id/cardView7"
                                    app:layout_constraintTop_toBottomOf="@+id/textView23"
                                    app:layout_constraintVertical_bias="0.0" />

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/btn_deposit"
                                    android:layout_width="60dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginEnd="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/background_stroke_around"
                                    android:backgroundTint="@color/blue_btn_search"
                                    android:clickable="true"
                                    android:padding="5dp"
                                    android:text="Nạp Tiền"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="10dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />


                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_is_membership"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter_light"
                            android:text="Bạn Đã Là Thành Viên Của Unwind"
                            android:textSize="14dp"
                            android:visibility="visible" />
                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <!--// Option Component-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!--// My Profile-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_person" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_profile"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// My Timeshare-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_home" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_timeshare"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />

                    </LinearLayout>

                    <!--// My Posting-->
                    <LinearLayout
                        android:id="@+id/ll_my_posting"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_my_posting" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_posting"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// My Transaction-->
                    <LinearLayout
                        android:id="@+id/ll_my_transaction"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_transaction" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="Giao dịch của tôi"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// My Order-->
                    <LinearLayout
                        android:id="@+id/ll_my_order"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_my_order" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_order"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// My Favorite-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_my_favourite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_favorite"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// Account  Security-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_my_posting" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_account_security"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// Account Link-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_link_account" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_account_link"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

            <!--// Help Center Container-->
            <LinearLayout
                android:id="@+id/ll_help_center"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="2dp"
                android:background="@color/white"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">


                <!--// Unwind Help Center-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_gravity="left|center"
                        android:layout_marginStart="5dp"
                        android:layout_weight="3"
                        android:src="@drawable/logo_unwind_horizontal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center"
                        android:layout_weight="6"
                        android:fontFamily="@font/inter_extrabold"
                        android:paddingStart="20dp"
                        android:text="@string/help_center"
                        android:textColor="@color/blue_btn_search"
                        android:textSize="16dp" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/baseline_navigate_next_24_black" />


                </LinearLayout>

            </LinearLayout>

            <!--// Version and Policy-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp">

                <!--// Versionr-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/ic_info" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center"
                        android:layout_weight="8"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingStart="20dp"
                        android:text="@string/version"
                        android:textSize="16dp" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/baseline_navigate_next_24_black" />


                </LinearLayout>

                <!--// Terms and policies-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/ic_info" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center"
                        android:layout_weight="8"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingStart="20dp"
                        android:text="@string/term_policy"
                        android:textSize="16dp" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/baseline_navigate_next_24_black" />


                </LinearLayout>

                <!--// Privacy Policie and Button-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/ic_privacy_polices" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center"
                        android:layout_weight="8"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingStart="20dp"
                        android:text="@string/privacy_policy"
                        android:textSize="16dp" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/baseline_navigate_next_24_black" />


                </LinearLayout>

                <!--// Lang Setting-->
                <LinearLayout
                    android:id="@+id/ll_setting_lang"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/ic_lang_setting" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left|center"
                        android:layout_weight="8"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingStart="20dp"
                        android:text="@string/setting"
                        android:textSize="16dp" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left|center"
                        android:layout_weight="1"
                        android:src="@drawable/baseline_navigate_next_24_black" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="150dp"
                    android:background="@drawable/ripple_effect_white"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/btn_logout"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_background"
                    android:textSize="20dp" />

            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>