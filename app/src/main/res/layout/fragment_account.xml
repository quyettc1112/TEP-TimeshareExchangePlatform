<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".UI.Activity.MainActivity.Fragment.AccountFragment.AccountFragment">

    <!-- // User Info Container-->
    <com.example.tep_timeshareexchangeplatform.AppConfig.CustomView.CustomToolbar.CustomToolbar
        android:id="@+id/toolblarCustome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:title="@string/profile_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showEndIcon="false"
        app:showShadow="false"
        app:showStartIcon="false"
        app:showStartText="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolblarCustome">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@color/primary_background"
            android:orientation="vertical">

            <!--// Option Container-->

            <!--// Help Center Component-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="vertical">
                <!--// User Avatar-->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_user_avt"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="30dp"
                    android:src="@drawable/ic_user_default_avt"
                    android:translationZ="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.151"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

                <!--// User Name-->
                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="Trần Cương Quyết"
                    android:textSize="20dp" />

                <TextView
                    android:id="@+id/tv_user_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_light"
                    android:text="some thing in here"
                    android:textSize="16dp" />

                <!--// Option Component-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!--// My Profile-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_person" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_profile"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// My Timeshare-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="5dp"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_home" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_timeshare"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />

                    </LinearLayout>

                    <!--// My Posting-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_my_posting" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_posting"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// My Order-->
                    <LinearLayout
                        android:id="@+id/ll_my_order"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_my_order" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_order"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// My Favorite-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_my_favourite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_favorite"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// Account  Security-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_my_posting" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_account_security"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>

                    <!--// Account Link-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal"
                        android:weightSum="10">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/ic_profile_link_account" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:layout_weight="8"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="20dp"
                            android:text="@string/my_account_link"
                            android:textSize="16dp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="left|center"
                            android:layout_weight="1"
                            android:src="@drawable/baseline_navigate_next_24_black" />


                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_help_center"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@color/white"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center"
                android:layout_marginTop="2dp">


                <!--// Unwind Help Center-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="3"
                        android:layout_marginStart="5dp"
                        android:layout_gravity="left|center"
                        android:src="@drawable/logo_unwind_horizontal"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:layout_gravity="left|center"
                        android:text="@string/help_center"
                        android:layout_weight="6"
                        android:textColor="@color/blue_btn_search"
                        android:fontFamily="@font/inter_extrabold"
                        android:textSize="16dp"
                        />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/baseline_navigate_next_24_black"/>




                </LinearLayout>

            </LinearLayout>

            <!--// Version and Policy-->
            <LinearLayout
                android:layout_marginTop="2dp"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <!--// Versionr-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/ic_info"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="8"
                        android:paddingStart="20dp"
                        android:layout_gravity="left|center"
                        android:text="@string/version"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="16dp"
                        />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/baseline_navigate_next_24_black"/>




                </LinearLayout>

                <!--// Terms and policies-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/ic_info"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="8"
                        android:paddingStart="20dp"
                        android:layout_gravity="left|center"
                        android:text="@string/term_policy"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="16dp"
                        />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/baseline_navigate_next_24_black"/>




                </LinearLayout>

                <!--// Privacy Policie and Button-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/ic_privacy_polices"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="8"
                        android:paddingStart="20dp"
                        android:layout_gravity="left|center"
                        android:text="@string/privacy_policy"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="16dp"
                        />
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/baseline_navigate_next_24_black"/>




                </LinearLayout>

                <!--// Lang Setting-->
                <LinearLayout
                    android:id="@+id/ll_setting_lang"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/ic_lang_setting"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="8"
                        android:paddingStart="20dp"
                        android:layout_gravity="left|center"
                        android:text="@string/setting"
                        android:fontFamily="@font/inter_semibold"
                        android:textSize="16dp"
                        />
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="left|center"
                        android:src="@drawable/baseline_navigate_next_24_black"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_logout"
                    android:background="@drawable/ripple_effect_white"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:text="@string/btn_logout"
                    android:textSize="20dp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/primary_background"
                    android:layout_height="50dp"
                    android:layout_marginBottom="150dp"
                    />

            </LinearLayout>



        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>